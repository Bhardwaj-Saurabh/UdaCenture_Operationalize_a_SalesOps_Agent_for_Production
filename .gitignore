# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (uv.lock and .python-version stay tracked)
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Generated at runtime (keep the folders, not the contents; reports/ stays tracked)
/logs/*
!/logs/.gitkeep
/traces/*
!/traces/.gitkeep
/data/email_outbox.json

# Local editor, OS and Claude Code settings
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
